options {
        directory "/var/cache/bind";

        recursion no;
        allow-recursion { none; };
        allow-query-cache { none; };

        listen-on { any; };
        listen-on-v6 { none; };

        allow-query {
                localhost;
                192.168.61.0/24;
        };

        allow-transfer { none; };
        notify no;

        dnssec-validation auto;

        version "not currently available";

        querylog yes;

        blackhole {
                0.0.0.0/8;
                100.64.0.0/10;
                169.254.0.0/16;
                172.16.0.0/12;
                224.0.0.0/3;
        };
};

controls { };
